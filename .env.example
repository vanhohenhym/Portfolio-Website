# Canonical domain used for sitemap.xml, robots.txt, canonical URLs, and Open Graph
NEXT_PUBLIC_SITE_URL=https://shahriarnadim.com

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML tag verification code
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Webhook URL that receives contact form submissions (e.g. Formspree, Make, Zapier, Slack).
# Required: without it the contact form returns a clear "not connected" error instead of
# silently dropping the message.
CONTACT_WEBHOOK_URL=

# Optional Headless WordPress endpoints
NEXT_PUBLIC_WORDPRESS_API_URL=
WORDPRESS_GRAPHQL_ENDPOINT=

