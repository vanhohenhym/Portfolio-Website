# Site origin (scheme + host, no subpath) used for canonical, Open Graph, sitemap,
# and robots. For GitHub Pages the deploy workflow sets this to the Pages origin;
# NEXT_PUBLIC_BASE_PATH is appended automatically for project sites.
NEXT_PUBLIC_SITE_URL=https://shahriarnadim.com

# Subpath for GitHub Pages project sites (e.g. /my-portfolio). Leave empty for
# local development, user sites (<user>.github.io), or a custom domain.
NEXT_PUBLIC_BASE_PATH=

# Formspree endpoint (public; submissions are posted directly from the browser).
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xbgodown

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML tag verification code
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional Headless WordPress endpoints (read at build time in static export)
NEXT_PUBLIC_WORDPRESS_API_URL=
WORDPRESS_GRAPHQL_ENDPOINT=
